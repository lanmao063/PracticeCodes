package aclass;

import java.util.Random;
public class machine extends compare
{
	private int [] number= new int[7];
	private int[] rankedNumber=new int[7];
	public void chooseNum()
	{
		Random random=new Random();
		for(int i=0;i<7;i++)
		{
			int index=random.nextInt(1,35);
			number[i]=index;
		}
		rank r = new rank(number);	
		rankedNumber=r.bubble();
	}
	
	public int[] getMachine()
	{
		return rankedNumber;
	}
	public void printNum()
	{
		for(int i:rankedNumber)
		{
			System.out.println(i);
		}
	}
